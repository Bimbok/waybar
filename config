{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
  	"on-sigusr1": "hide",
	  "on-sigusr2": "show",
    "spacing": 0,
    "margin-top": 10,
    "width": 300,
    "height": 48,
    "modules-left": [
        "custom/logo",
        "clock",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/cava",
    ],
    "modules-right": [
        "group/connection-drawer",
        "wireplumber",
        "group/hardware",
        "group/power-drawer"
    ],
    "custom/autohide": {
        "exec": "~/.config/waybar/Scripts/WaybarAutoHide module",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "return-type": "json",
        "tooltip": true,
        "on-click": "~/.config/waybar/Scripts/WaybarAutoHide toggle"
    },
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "2": "", 
            "default": "",
            "active": "",
            "urgent": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
        }
    },
    "custom/media-art": {
        "exec": "/home/bimbok/.config/waybar/Scripts/media-art.py",
        "format": "{}",
        "return-type": "json"
    },
    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} <i>{title}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": " ",
            "spotify": " ",
            "firefox": " ",
            "chromium": " ",
            "brave": " ",
            "vlc": "󰕼 ",
            "amberol": "󰎆 "
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 20
    },
    "custom/cava": {
        "exec": "/home/bimbok/.config/waybar/Scripts/cava.sh",
        "format": "{}",
        "tooltip": false,
        "restart-interval": 2
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "Memory: {used:0.1f}G / {total:0.1f}G ({percentage}%)"
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
          "tooltip-format": "<tt><small>{calendar}</small></tt>",
          "calendar": {
              "mode"          : "month",
              "mode-mon-col"  : 3,
              "weeks-pos"     : "right",
              "on-scroll"     : 1,
              "format": {
                    "months":     "<span color='#ffead3'><b>{}</b></span>",
                    "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                    "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                    "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                    "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
           }
        },
        "actions":  {
              "on-click-right": "mode",
              "on-scroll-up": "shift_up",
              "on-scroll-down": "shift_down"
        },
        "format-alt": " {:%a, %d %b %Y}",
        "format": " {:%I:%M %p}"
    },
    "bluetooth": {
        "format": "",
        "format-connected": " {num_connections}",
        "format-connected-battery": " {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "on-click": "/home/bimbok/.config/waybar/Scripts/bluetooth.sh &"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "format-ethernet": "󰀂 ",
        "format-alt": "󱛇 ",
        "format-disconnected": "󰖪 ",
        "format-disabled": "󰖪 ",
        "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "/home/bimbok/.config/waybar/Scripts/wifi.sh &",
        "on-click-right": "~/.config/rofi/wifi/wifinew.sh &",
        "interval": 5
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "nospacing": 1,
        "tooltip-format": "Volume : {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂰",
            "headset": "󰂰",
            "bluetooth": "󰂰",
            "default": ["󰖀 ", "󰕾 ", " "]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
        "scroll-step": 1
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞 ", "󰃟 ", "󰃠 "],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "min-length": 6
    },
    "custom/logo": {
        "format": "  ",
        "tooltip": false,
        "on-click": "/home/bimbok/.config/waybar/Scripts/theme-change.sh &",
        "on-click-right": "~/.config/waybar/Scripts/wallpaper_select.sh &"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": {
            "charging": ["󰢜 ","󰂆 ","󰂇 ","󰂈 ","󰢝 ","󰂉 ","󰢞 ","󰂊 ","󰂋 ","󰂅 "],
            "default": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
        },
        "format-full": "{icon} {capacity}%",
        "interval": 5,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "tooltip": true,
        "tooltip-format": "{timeTo} {capacity}%"
    },
        "custom/power": {
        "format": "󰤆",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "group/power-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/autohide"
        ]
    },
      "group/connection-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-power",
            "transition-left-to-right": false
        },
        "modules": [
            "network",
            "tray",
            "bluetooth"

        ]
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "cpu",
            "memory"
        ],
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-hardware",
            "transition-left-to-right": false
        }
    }
}
