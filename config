{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "height": 42,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "mpris",
        "custom/cava"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "wireplumber",
        "network",
        "bluetooth",
        "cpu",
        "memory",
        "battery",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "custom/media-art": {
        "exec": "/home/bimbok/.config/waybar/Scripts/media-art.py",
        "format": "{}",
        "return-type": "json"
    },
    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} <i>{title}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": " ",
            "spotify": " ",
            "firefox": " ",
            "chromium": " ",
            "brave": "󰖟 ",
            "vlc": "󰕼 ",
            "amberol": "󰎆 "
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 20
    },
    "custom/cava": {
        "exec": "/home/bimbok/.config/waybar/Scripts/cava.sh",
        "format": "{}",
        "tooltip": false,
        "restart-interval": 2
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "Memory: {used:0.1f}G / {total:0.1f}G ({percentage}%)"
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%a, %d %b %Y}",
        "format": " {:%I:%M %p}"
    },
    "bluetooth": {
        "format": "",
        "format-connected": " {num_connections}",
        "format-connected-battery": " {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "on-click": "/home/bimbok/.config/waybar/Scripts/bluetooth.sh &"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "format-ethernet": "󰀂 ",
        "format-alt": "󱛇 ",
        "format-disconnected": "󰖪 ",
        "format-disabled": "󰖪 ",
        "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "/home/bimbok/.config/waybar/Scripts/wifi.sh &",
        "on-click-right": "~/.config/rofi/wifi/wifinew.sh &",
        "interval": 5
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "nospacing": 1,
        "tooltip-format": "Volume : {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂰",
            "headset": "󰂰",
            "bluetooth": "󰂰",
            "default": ["󰖀 ", "󰕾 ", " "]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
        "scroll-step": 1
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞 ", "󰃟 ", "󰃠 "],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "min-length": 6
    },
    "custom/logo": {
        "format": "  ",
        "tooltip": false,
        "on-click": "/home/bimbok/.config/waybar/Scripts/theme-change.sh &",
        "on-click-right": "~/.config/waybar/Scripts/wallpaper_select.sh &"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": {
            "charging": ["󰢜 ","󰂆 ","󰂇 ","󰂈 ","󰢝 ","󰂉 ","󰢞 ","󰂊 ","󰂋 ","󰂅 "],
            "default": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
        },
        "format-full": "{icon} {capacity}%",
        "interval": 5,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "tooltip": true,
        "tooltip-format": "{timeTo} {capacity}%"
    },
        "custom/power": {
        "format": "󰤆",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
