#!/usr/bin/env bash

STATE_FILE="$HOME/.config/waybar/Scripts/.Locked"
VISIBLE_FILE="$HOME/.config/waybar/Scripts/.Visible"
PID_FILE="$HOME/.config/waybar/Scripts/.AutohidePid"
CONFIG_FILE="$HOME/.config/waybar/config"
POLL_DELAY=0.10
MODULE_SIGNAL="RTMIN+8"

# [ GREP FUNCTIONS ]

get_cursor_pos() { hyprctl cursorpos; }

get_resolution() {
  hyprctl -j monitors | jq -r '.[] | select(.focused==true) | "\(.width)x\(.height)"'
}

get_bar_position() {
  grep -m1 '"position"' "$CONFIG_FILE" | sed -E 's/.*"position":[[:space:]]*"([^"]+)".*/\1/'
}

get_tiled_on_active_ws() {
  local ws=$(hyprctl activeworkspace | awk '/workspace ID/ {print $3}')
  hyprctl clients | awk -v ws="$ws" '
        /^Window /{cur_ws="";floating=""}
        /^\s*workspace:/{cur_ws=$2}
        /^\s*floating:/{floating=$2}
        cur_ws==ws && floating==0 {count++;cur_ws=""}
        END{print count+0}'
}

focused_special_ws() {
  hyprctl monitors | awk '
        BEGIN {focused=0; special=-1}
        /^Monitor / {focused=0; special=-1}
        /focused: yes/ {focused=1}
        /special workspace:/ {special=$3}
        END {exit !(focused==1 && special != -1 && special != 0)}'
}

refresh_module() { pkill -"${MODULE_SIGNAL}" waybar 2>/dev/null || true; }

show_bar() {
  if [ ! -f "$VISIBLE_FILE" ]; then
    pkill -SIGUSR2 waybar
    touch "$VISIBLE_FILE"
    refresh_module
  fi
}

hide_bar() {
  if [ -f "$VISIBLE_FILE" ]; then
    pkill -SIGUSR1 waybar
    rm -f "$VISIBLE_FILE"
    refresh_module
  fi
}

ensure_single_runner() {
  if [ -f "$PID_FILE" ]; then
    local existing_pid
    existing_pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
      exit 0
    fi
  fi

  printf '%s\n' "$$" >"$PID_FILE"
  trap 'rm -f "$PID_FILE"' EXIT
}

# [ AUTO-HIDE WAYBAR ]

autohide_mode() {
  ensure_single_runner

  while true; do
    CURSOR=$(get_cursor_pos)
    X=$(echo "$CURSOR" | cut -d',' -f1)
    Y=$(echo "$CURSOR" | cut -d',' -f2)

    RES=$(get_resolution)
    WIDTH=${RES%x*}
    HEIGHT=${RES#*x}

    POSITION=$(get_bar_position)

    tiled=$(get_tiled_on_active_ws)
    special=$(focused_special_ws && echo 1 || echo 0)

    case "$POSITION" in

    top)
      EDGE1=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.01}')
      EDGE2=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.1}')

      SHOW_CONDITION=$((Y <= EDGE1))
      HIDE_CONDITION=$((Y > EDGE2))
      ;;

    bottom)
      EDGE1=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.9}')
      EDGE2=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.99}')

      SHOW_CONDITION=$((Y >= EDGE2))
      HIDE_CONDITION=$((Y < EDGE1))
      ;;

    left)
      EDGE1=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.01}')
      EDGE2=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.1}')

      SHOW_CONDITION=$((X <= EDGE1))
      HIDE_CONDITION=$((X > EDGE2))
      ;;

    right)
      EDGE1=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.9}')
      EDGE2=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.99}')

      SHOW_CONDITION=$((X >= EDGE2))
      HIDE_CONDITION=$((X < EDGE1))
      ;;

    *)
      EDGE1=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.01}')
      EDGE2=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.1}')

      SHOW_CONDITION=$((Y <= EDGE1))
      HIDE_CONDITION=$((Y > EDGE2))
      ;;
    esac

    if ((special || tiled == 0 || tiled >= 2 || (tiled == 1 && SHOW_CONDITION))); then
      show_bar
    elif ((tiled == 1 && HIDE_CONDITION)); then
      hide_bar
    fi

    sleep "$POLL_DELAY"
  done
}

# [ TOGGLE WAYBAR ]

toggle_mode() {
  if [ -f "$STATE_FILE" ]; then
    rm "$STATE_FILE"
    show_bar
    refresh_module
    nohup "$0" >/dev/null 2>&1 &
  else
    touch "$STATE_FILE"
    if [ -f "$PID_FILE" ]; then
      pid=$(cat "$PID_FILE" 2>/dev/null)
      [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    show_bar
    refresh_module
  fi
}

# [ WAYBAR MODULE & TOGGLE ]

module_mode() {
  if [ -f "$STATE_FILE" ]; then
    printf '{"text":" Pinned","alt":"pinned","class":["locked"],"tooltip":"Pinned: autohide disabled"}\n'
  else
    if [ -f "$VISIBLE_FILE" ]; then
      printf '{"text":" Auto","alt":"auto","class":["auto","visible"],"tooltip":"Auto-hide enabled. Move the cursor to the top edge to reveal the bar."}\n'
    else
      printf '{"text":" Auto","alt":"auto","class":["auto","hidden"],"tooltip":"Auto-hide enabled. The bar will appear when you hit the top edge."}\n'
    fi
  fi
}

case "$1" in
toggle) toggle_mode ;;
module) module_mode ;;
*) [ -f "$STATE_FILE" ] || autohide_mode ;;
esac
